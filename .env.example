# ===========================================
# Shortify — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Server
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgresql://shortify:shortify_password@localhost:5432/shortify?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://shortify:shortify_password@localhost:5672

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-must-be-long-and-random
JWT_REFRESH_SECRET=change-me-refresh-secret-must-be-long-and-random
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_URL_CREATE_WINDOW_MS=60000
RATE_LIMIT_URL_CREATE_MAX=20
RATE_LIMIT_REDIRECT_WINDOW_MS=1000
RATE_LIMIT_REDIRECT_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

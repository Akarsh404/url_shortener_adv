{
  "version": 2,
  "buildCommand": "npx prisma generate && npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": "/public/$1" },
    { "source": "/app", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}

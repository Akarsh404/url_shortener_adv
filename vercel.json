{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/app/(.*)", "dest": "/public/$1" },
    { "src": "/app/?$", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/dist/index.js" }
  ]
}

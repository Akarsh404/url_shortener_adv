// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  urls          Url[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Url {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shortCode   String    @unique @map("short_code") @db.VarChar(20)
  originalUrl String    @map("original_url") @db.VarChar(2048)
  customAlias String?   @unique @map("custom_alias") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]

  // Index on shortCode is implicit via @unique
  // Index on customAlias is implicit via @unique
  @@index([userId], name: "idx_urls_user_id")
  @@index([createdAt], name: "idx_urls_created_at")
  @@index([expiresAt], name: "idx_urls_expires_at")
  @@index([isActive, expiresAt], name: "idx_urls_active_expires")
  @@map("urls")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user_id")
  @@index([tokenHash], name: "idx_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

model ClickEvent {
  id        String   @id @default(uuid()) @db.Uuid
  urlId     String   @map("url_id") @db.Uuid
  clickedAt DateTime @default(now()) @map("clicked_at")
  userAgent String?  @map("user_agent") @db.VarChar(512)
  referrer  String?  @db.VarChar(2048)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  // Supports analytics queries: COUNT by urlId, GROUP BY date
  @@index([urlId, clickedAt], name: "idx_click_events_url_clicked")
  @@index([clickedAt], name: "idx_click_events_clicked_at")
  @@map("click_events")
}
